{
  "appId": "com.unified.system",
  "productName": "UnifiedSystem",
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "dist/**/*",
    "src/electron/**/*"
  ],
  "win": {
    "target": "nsis",
    "icon": "public/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": true
  }
}
